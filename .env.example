# =============================================================================
#  MomentSearch — copy this file to .env and fill in what you need.
#
#    Models & provider keys (full list)   ->  MODELS.md
#    Deploying (storage buckets per cloud) ->  DEPLOYMENT.md
#    Check what your .env resolved to      ->  python -m src.providers
#
#  Just running locally? Use .env.local.example instead — a keyless preset.
# =============================================================================


# #############################################################################
#  DECISIONS — what to run
# #############################################################################

# =============================================================================
#  THE DEMO NEEDS NOTHING FROM YOU.
#  Ten sample videos ship pre-indexed in demo_corpus/ — frames and transcripts in
#  demo_corpus/objects, vectors in demo_corpus/qdrant (the bundled qdrant service
#  mounts it), rows in demo_corpus/manifest.sql. They are read from there at
#  RUNTIME, whatever you set below, so /demo answers on a fresh clone with no
#  indexing, no keys and no bill. Everything in this file is about YOUR OWN
#  videos. (config.DEMO_LOCAL turns that off if you'd rather host the samples
#  yourself; DEMO_QDRANT_URL / DEMO_STORAGE_DIR move where they're read from.)
# =============================================================================

# --- Storage for YOUR uploads ------------------------------------------------
# Where your videos + thumbnails live: local | aws | gcp | gcp_native | flyio
# local = ./data on disk. For a deploy, pick a bucket — steps in DEPLOYMENT.md.
# The samples ignore this setting; they stay in demo_corpus/objects.
STORAGE_PROVIDER=local

# Bundled containers `docker compose up` also starts (blank = none):
#   local-postgres  -> DATABASE_URL=postgresql://ms:ms@postgres:5432/ms
# The qdrant service is NOT in this list: it is the demo's own store and always
# runs. Your uploads only go there if QDRANT_URL points at it.
COMPOSE_PROFILES=local-postgres

# --- Models  (keys go in VALUES below; all options -> MODELS.md) ------------
IMAGE_EMBED_PROVIDER=clip     # frames + query (visual search). clip = local, free.
TEXT_EMBED_PROVIDER=openai    # transcript chunks. fastembed = local, free.
LLM_PROVIDER=openai           # writes the answer (vision model). blank key = no prose.
ASR_PROVIDER=openai           # transcribes uploaded videos.
RERANK_PROVIDER=fastembed     # re-ranks transcript hits. fastembed = local, free.
# Changing an embedder or its model changes the vector dim — give it a fresh
# IMAGE_COLLECTION / TEXT_COLLECTION name (below), or the old index won't load.
# It also orphans the SHIPPED corpus: demo_corpus/ was embedded with clip-ViT-L-14
# and text-embedding-3-small, and a query embedded by anything else can't match it.
# Switching models means rebuilding it — src/build_demo_corpus.py.

# --- Features on / off ------------------------------------------------------
ENABLE_TRANSCRIPT=true        # false = visual search only
ENABLE_ASR=true               # transcribe uploads (uses the OpenAI key)
ENABLE_RERANK=true            # rerank transcript hits (first query pulls ~90MB)
DIARIZE_ENABLED=true          # "who said what" (needs GEMINI_API_KEY)
ENABLE_FAIR_DISPATCH=true     # round-robin videos across users (vs plain FIFO)
DEDUP_ENABLED=true            # drop near-identical frames before embedding
SEED_SAMPLE_VIDEOS=true       # the gate is on (SEED_MODE decides what it does)
# restore = load the shipped corpus (seconds, the default while demo_corpus/ is
# present) | ingest = index the samples live into YOUR stores (~45 min, needs
# YouTube to cooperate). Unset is the right answer for almost everyone.
# SEED_MODE=restore

# Low-RAM Qdrant (int8 copies in RAM, originals on disk). Turn off on a big-RAM box.
QDRANT_QUANTIZATION=true
QDRANT_ON_DISK=true
QDRANT_HNSW_ON_DISK=true

# --- Deploy safety  (see DEPLOYMENT.md) -------------------------------------
DEPLOY_ENV=production         # marks a deploy so preflight warns on local settings
# STRICT_DEPLOY_CHECK=false   # true = refuse to start instead of just warning
# SEED_STRICT=false           # true = a failed sample-seed aborts the deploy
# FLY_IO_TOKEN=               # for flyctl on your machine only (the app never reads it)


# #############################################################################
#  VALUES — credentials + numbers
# #############################################################################

# --- Database (Postgres) ----------------------------------------------------
# Neon -> Connection Details -> Pooled connection. Local: use the local-postgres profile.
# The one store the demo SHARES with you: sample rows are replayed into this
# database at startup (a session joins videos to chats with a foreign key, so
# they have to live together). Ten small rows, idempotent, local or hosted.
DATABASE_URL=postgresql://ms:ms@postgres:5432/ms
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Vector store (Qdrant) --------------------------------------------------
# Cloud: URL + key from cloud.qdrant.io. Local: local-qdrant profile, blank key.
# Where YOUR videos' vectors go. http://qdrant:6333 is the bundled service (it
# is already running for the demo, so this costs nothing extra); a Qdrant Cloud
# URL sends your uploads there instead. Either way the samples keep answering
# from demo_corpus/qdrant.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
IMAGE_COLLECTION=moments_l14         # frames — must match the visual model's dim
TEXT_COLLECTION=moments_text_openai  # transcripts — must match the text model's dim

# --- Work queue (Prefect Cloud) ---------------------------------------------
# Free, no card: app.prefect.cloud -> avatar -> API Keys.
PREFECT_API_URL=
PREFECT_API_KEY=
WORKER_CONCURRENCY=2          # videos in parallel per worker (~1-1.5GB RAM each)
DISPATCH_MAX_INFLIGHT=2       # total at once = worker machines x concurrency

# --- Object storage keys  (per-cloud steps + CORS -> DEPLOYMENT.md) ---------
# Keep the bucket PRIVATE. Browser uploads need a CORS rule (in the cloud guide).
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto           # aws: the bucket's REAL region (not 'auto')
AWS_ENDPOINT_URL_S3=""        # custom S3 endpoint; flyio + aws fill it in for you
MAX_UPLOAD_MB=2048            # ~90 min of 720p; shown on the uploader
# PRESIGN_EXPIRY_S=900
# PRESIGN_GET_EXPIRY_S=3600
# gcp_native uses GOOGLE_CLOUD_* keys instead of the above — see gcp.md.

# --- Model keys  (which key each provider needs -> MODELS.md) ---------------
# One OPENAI_API_KEY powers the answer, transcript embeddings AND Whisper.
OPENAI_API_KEY=
GEMINI_API_KEY=""             # also used for diarization ("who said what")
# LLM_API_KEY=                # overrides the provider key above — CLEAR it when switching providers
LLM_MODEL=gpt-4o             # blank = the provider's default
LLM_IMAGE_MAX_PX=512          # frames downscaled to this before the LLM
# LLM_BASE_URL=              # point at your own OpenAI-compatible server (see MODELS.md)

# --- Visual embedder --------------------------------------------------------
# clip-ViT-L-14 (dim 768) is more accurate but ~1.7GB + slower to embed on CPU.
CLIP_MODEL=clip-ViT-L-14      # dim 768 — what demo_corpus/ was built with
CLIP_BATCH=128
# Warm CLIP service: docker-compose sets http://clip:8001; Fly derives it;
# blank (and off Fly) = embed in-process. See DEPLOYMENT.md "fat vs slim".
EMBED_SERVICE_URL=
# EMBED_SERVICE_TOKEN=        # bearer auth when clip runs on a public network
# EMBED_VERSION=              # bump to force a full re-index

# --- Ingest & retrieval tuning  (defaults are sensible) ---------------------
FRAME_STRATEGY=interval       # interval (every N sec) | scene (one per cut)
FRAME_INTERVAL_SEC=2
SCENE_THRESHOLD=0.4           # for FRAME_STRATEGY=scene; lower = more frames
MAX_FRAMES=400                # hard cap per video
THUMB_WIDTH=480
DEDUP_MAX_DISTANCE=4          # near-duplicate frame threshold (dHash Hamming)
TOP_K=6                       # moments sent to the LLM
KNN_K=24                      # candidates fetched before trimming
CONTEXT_PAD_S=10              # seconds of speech around each moment the model also reads (0 = off)
MULTI_QUERY=true              # split multi-part questions and search each part in parallel
FRAME_SCORE_RATIO=0           # per-moment pruning, off by default — why: src/config.py
TEXT_RERANK_FLOOR=0           # (frame share-of-best / reranker relevance floor)
# More knobs — abstain gate, fusion, per-model overrides, ASR, reranker,
# diarization, local runtimes — are in MODELS.md and src/config.py.

# --- YouTube  (only if a link won't ingest) ---------------------------------
# YouTube bot-checks by IP. On a DEPLOY the datacenter IP is almost always blocked
# (captions fail first). Two ways past it — pick ONE (details in README):
#
# A) SocialKit — a hosted API that returns BOTH the transcript and the video
#    from its own servers (no cookies, no proxy, no IP fight). Just paste the
#    key; it's used automatically, with yt-dlp as the fallback. Free: 20 credits,
#    then paid. Docs: https://docs.socialkit.dev
# B) Cookies/proxy — keep fetching with yt-dlp from your own IP, authenticated.
#    Free, but cookies expire ~2-3 weeks; a proxy is paid but hands-off.
SOCIALKIT_API_KEY=            # (A) free key at socialkit.dev — transcript + video
YT_COOKIES_FILE=""            # (B) local / VM: /app/secrets/cookies.txt
YT_COOKIES_B64=""             # (B) deploy (Fly/ECS/GKE): base64 of cookies.txt
YT_PROXY_URL=""               # (B) alternative to cookies: http://user:pass@host:port

# --- Import from Google Drive  (optional) -----------------------------------
# Off until both are set. In Google Cloud console: enable "Google Picker API",
# make an OAuth client (Web) + an API key, both restricted to your app origin.
GDRIVE_CLIENT_ID=
GDRIVE_API_KEY=

# --- Single-user: NO AUTHENTICATION -----------------------------------------
# !! Opening the app IS being logged in as the one account. There is no sign-in.
# !! Bind to localhost or put an authenticating proxy in front of it.
# SINGLE_USER_ID=default        # changing this orphans the pre-indexed samples
