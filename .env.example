# =============================================================================
#  MomentSearch — configuration.  Copy this file to .env
#
#  PART 1 · DECISIONS   what to switch on/off, and which provider to use.
#                       Every line is shown at its DEFAULT — read these first.
#  PART 2 · VALUES      the credentials and numbers behind those decisions.
#
#  Anytime:  python -m src.providers    <- prints what your .env resolved to
#
#  Just want it running locally? Use .env.local.example instead — it is this
#  file with every decision already made for a keyless local stack.
# =============================================================================


# #############################################################################
#  PART 1 · DECISIONS
# #############################################################################

# --- Where the data lives ----------------------------------------------------
# STORAGE_PROVIDER: local | aws | gcp | gcp_native | flyio
#   local = files under ./data, no bucket, no keys (dev default)
STORAGE_PROVIDER=local

# COMPOSE_PROFILES: which bundled services `docker compose up` also starts.
# Comma-separated, blank = none. Pair each with its URL in PART 2.
#   local-qdrant     a Qdrant container      -> QDRANT_URL=http://qdrant:6333
#   local-postgres   a Postgres container    -> DATABASE_URL=postgresql://ms:ms@postgres:5432/ms
COMPOSE_PROFILES=

# --- Which models ------------------------------------------------------------
# A provider NAME is a complete choice: it sets the endpoint, the default model
# and the vector dim. Keys go in PART 2. Full tables: see README.

# Frames + the question, one shared space (this is the visual search):
#   clip (default, local, free, no key) | jina | cohere | voyage | gemini
IMAGE_EMBED_PROVIDER=clip

# Transcript chunks:
#   openai (default, needs OPENAI_API_KEY) | fastembed (local, free, no key)
#   | gemini | cohere | voyage | jina
TEXT_EMBED_PROVIDER=openai

# Writes the final cited answer. Must be VISION-capable. Leave the key blank in
# PART 2 for retrieval-only mode (ranked clickable moments, no prose).
#   openai (default) | gemini | anthropic | openrouter | xai | groq | together
#   | fireworks | mistral | nvidia | azure_openai | ollama | lmstudio | vllm | custom
LLM_PROVIDER=openai

# Transcribes UPLOADED videos (YouTube uses its own captions):
ASR_PROVIDER=openai

# Re-judges the top transcript hits after fusion:
#   fastembed (default, local ONNX, no key) | cohere
RERANK_PROVIDER=fastembed

# !! Switching an embedding provider or model CHANGES THE VECTOR DIM, which makes
# !! the existing index unusable. MomentSearch refuses to mix them. Re-index, or
# !! point QDRANT_COLLECTION / TEXT_COLLECTION at fresh collection names.

# --- Features on / off -------------------------------------------------------
# The transcript branch. false = pure visual search.
ENABLE_TRANSCRIPT=true

# Speech-to-text for uploads. false = uploads index visually only (and you need
# no OpenAI key for them).
ENABLE_ASR=true

# Cross-encoder reranker. Fixes RRF's rank-blindness: RRF orders by branch RANK
# and ignores how relevant a hit really is, so a spurious top-1 can outrank the
# real answer one rank below it. First query after boot downloads a ~90MB model.
ENABLE_RERANK=true

# Speaker recognition ("who said what"). Master switch — each video is still
# opt-in via a checkbox at upload, and it always needs GEMINI_API_KEY.
DIARIZE_ENABLED=true

# Fair queueing (WFQ). true = a dispatcher admits videos round-robin across
# users, so one bulk uploader can't starve everyone else. false = plain FIFO.
ENABLE_FAIR_DISPATCH=true

# Perceptual-hash dedup — drops near-identical frames BEFORE they cost embedding
# compute and storage.
DEDUP_ENABLED=true

# Index the sample talk on startup so /demo can answer immediately.
# false = bare deploy, fastest first start, upload your own.
SEED_SAMPLE_VIDEOS=true

# Low-RAM Qdrant profile. Frame vectors balloon fast, so these default ON:
# originals on disk, int8 copies (~4x smaller) pinned in RAM do the search,
# queries rescore from the originals. Flip off on a big-RAM node for speed.
QDRANT_QUANTIZATION=true
QDRANT_ON_DISK=true
QDRANT_HNSW_ON_DISK=true

# --- How frames are sampled --------------------------------------------------
# The biggest scaling lever — this is what stops thousands of videos becoming
# billions of near-identical vectors.
#   interval = one frame every FRAME_INTERVAL_SEC
#   scene    = one frame per detected cut
FRAME_STRATEGY=interval

# --- Strictness (deploys) ----------------------------------------------------
# Seeding: false = best-effort. A seed that can't finish (e.g. a fresh clone
# whose empty Qdrant forces a live YouTube re-index without cookies) logs loudly
# and the app still starts with an empty /demo. true = an incomplete seed aborts
# the deploy / compose start.
# SEED_STRICT=false

# Deploy sanity check (src/preflight.py). On a DEPLOY (Fly injects FLY_APP_NAME,
# or set DEPLOY_ENV=production) it warns when a LOCAL setting is present —
# STORAGE_PROVIDER=local, a compose-only qdrant/postgres host, COMPOSE_PROFILES —
# because those break in production. true = refuse to start instead of warning.
# No-op off a deploy.
# STRICT_DEPLOY_CHECK=false


# #############################################################################
#  PART 2 · VALUES
# #############################################################################

# =============================================================================
#  1 · Database — the video manifest
#  Neon console -> your project -> Connection Details -> "Pooled connection".
#  Local Postgres instead: put local-postgres in COMPOSE_PROFILES (PART 1) and
#  use  postgresql://ms:ms@postgres:5432/ms  — tables create themselves.
# =============================================================================
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# =============================================================================
#  2 · Object storage — raw videos + frame thumbnails
#  All providers speak the S3 API (GCS via S3-interoperability, Fly via Tigris)
#  except gcp_native, which uses Google's SDK + a service-account JSON.
#  Credentials use provider-neutral STORAGE_* names; AWS_* names also work
#  (that's what boto3 reads natively and what `fly storage create` injects).
#
#  !! BROWSER UPLOADS NEED A CORS RULE allowing PUT from your site's origin, or
#  !! every presigned upload fails in the browser:
#  !!   AWS:    aws s3api put-bucket-cors --bucket X --cors-configuration '{"CORSRules":[{"AllowedMethods":["PUT","GET"],"AllowedOrigins":["https://your.app"],"AllowedHeaders":["*"]}]}'
#  !!   GCS:    gcloud storage buckets update gs://X --cors-file=cors.json
#  !!   Tigris: fly storage dashboard -> your bucket -> Settings -> CORS
#  Keep the bucket PRIVATE — only presigned URLs get in or out.
# =============================================================================
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
AWS_ENDPOINT_URL_S3=

# Presigned-upload guardrails.
# 2048 MB ≈ a 90-minute video at 720p (H.264, ~2.5 Mbps). Enforced three times
# server-side — at presign, on the dev direct-upload stream, and again by the
# HEAD check at register, so a client that skips the presign check still can't
# land an oversized object. The workspace reads this number from /api/config and
# prints it on the uploader, so raising it here updates the UI with no edit.
MAX_UPLOAD_MB=2048
PRESIGN_EXPIRY_S=900
PRESIGN_GET_EXPIRY_S=3600

# --- Per-provider setup (uncomment the block for your STORAGE_PROVIDER) ------
#
# local — nothing to set. The API accepts and serves bytes itself, under ./data
#
# aws
#   Create a bucket, then an IAM user with s3:PutObject / GetObject / HeadObject
#   / DeleteObject / ListBucket on it. STORAGE_REGION must be the real region.
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=AKIA................
# STORAGE_SECRET_ACCESS_KEY=....................
# STORAGE_REGION=us-east-1
#
# gcp — Cloud Storage over its S3-interoperability API
#   Service account with "Storage Object Admin", then Cloud Storage -> Settings
#   -> Interoperability -> create an HMAC key for it.
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=GOOG1E..............
# STORAGE_SECRET_ACCESS_KEY=....................
#
# gcp_native — Google's SDK + service-account JSON (no HMAC keys)
#   Requires: pip install google-cloud-storage
# STORAGE_BUCKET=momentsearch-media
# GOOGLE_CLOUD_PROJECT_ID=your-project
# GOOGLE_CLOUD_PRIVATE_KEY_ID=....................
# GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CLOUD_CLIENT_EMAIL=sa-name@your-project.iam.gserviceaccount.com
# GOOGLE_CLOUD_CLIENT_ID=....................
# GOOGLE_CLOUD_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/sa-name%40your-project.iam.gserviceaccount.com
#
# flyio — Tigris, Fly's native S3-compatible storage
#   Run `fly storage create` from the app directory: it injects the AWS_*-named
#   secrets + BUCKET_NAME on the deployed app, so there you set only
#   STORAGE_PROVIDER=flyio. Copy the keys from the Tigris dashboard to reuse the
#   same bucket locally.
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=tid_................
# STORAGE_SECRET_ACCESS_KEY=tsec_................

# =============================================================================
#  3 · Work queue (Prefect Cloud) + workers
#  The API only schedules runs; workers poll Prefect over outbound HTTPS and
#  execute them. Free tier, no card: sign up -> avatar -> API Keys -> Create.
#  PREFECT_API_URL looks like
#    https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
# =============================================================================
PREFECT_API_URL=
PREFECT_API_KEY=

# Concurrent flow runs per worker process. Each is an isolated subprocess and
# ffmpeg + CLIP peaks around 1-1.5GB — size the machine accordingly.
WORKER_CONCURRENCY=2

# Max videos executing at once across the fleet. Set it to your REAL capacity:
# (worker machines) x WORKER_CONCURRENCY. Anything higher just piles up FIFO
# inside Prefect and defeats the fair queueing.
DISPATCH_MAX_INFLIGHT=2
# DISPATCH_INTERVAL_S=3            # how often the dispatcher tops up

# =============================================================================
#  4 · Qdrant — the vector index
#  Cloud: cluster URL + API key from cloud.qdrant.io.
#  Local: put local-qdrant in COMPOSE_PROFILES (PART 1) and use
#         QDRANT_URL=http://qdrant:6333 with a blank key.
#  Empty QDRANT_URL = an EMBEDDED instance under ./data/qdrant — single-process
#  only (api + worker cannot share it), so bare-process dev only.
# =============================================================================
QDRANT_URL=
QDRANT_API_KEY=

# One collection per vector shape. Both defaults match the default models above;
# change the model and you need a new collection name here too.
QDRANT_COLLECTION=moments_l14        # frames  (clip-ViT-L-14, dim 768)
TEXT_COLLECTION=moments_text_openai  # transcripts (text-embedding-3-small, 1536)

# =============================================================================
#  5 · Model keys
#  One OPENAI_API_KEY covers three defaults at once: the answer LLM, the
#  transcript embeddings AND Whisper. Set TEXT_EMBED_PROVIDER=fastembed and
#  ENABLE_ASR=false (PART 1) to run with no key at all.
# =============================================================================
LLM_API_KEY=
# CAREFUL: LLM_API_KEY beats the provider-specific var below. Switching
# LLM_PROVIDER without clearing it is the #1 cause of "API key not valid".

# Provider-specific keys — set the one your PART 1 choices need.
# OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# AZURE_OPENAI_API_KEY=  + AZURE_OPENAI_ENDPOINT=
# COHERE_API_KEY=
# VOYAGE_API_KEY=
# JINA_API_KEY=
#
#   provider        key env var           default model
#   openai          OPENAI_API_KEY        gpt-4o
#   gemini          GEMINI_API_KEY        gemini-3.6-flash   (pip install google-genai)
#   gemini_openai   GEMINI_API_KEY        gemini-3.6-flash   (no extra install)
#   anthropic       ANTHROPIC_API_KEY     claude-sonnet-5    (pip install anthropic)
#   openrouter      OPENROUTER_API_KEY    openai/gpt-4o-mini
#   xai (grok)      XAI_API_KEY           grok-4.5
#   groq            GROQ_API_KEY          — set LLM_MODEL
#   together        TOGETHER_API_KEY      Qwen/Qwen2.5-VL-72B-Instruct
#   fireworks       FIREWORKS_API_KEY     — set LLM_MODEL
#   mistral         MISTRAL_API_KEY       pixtral-12b-2409
#   nvidia          NVIDIA_API_KEY        meta/llama-3.2-11b-vision-instruct
#   azure_openai    AZURE_OPENAI_API_KEY  — LLM_MODEL is your DEPLOYMENT name
#   ollama          (none)                qwen2.5vl        localhost:11434
#   lmstudio        (none)                — set LLM_MODEL  localhost:1234
#   vllm            (none)                — set LLM_MODEL  localhost:8000
#   custom          (optional)            — set LLM_BASE_URL
# Aliases work: grok, claude, google, azure, lm-studio, open-router.

# Answer model details. Blank model = the provider's default.
LLM_MODEL=gpt-4o
LLM_IMAGE_MAX_PX=512     # frames are downscaled to this before the LLM (tokens are the cost)
# LLM_MAX_TOKENS=1024
# LLM_BASE_URL=          # point any OpenAI-shaped provider at YOUR server:
#                        #   Ollama        -> http://localhost:11434/v1
#                        #   vLLM/LMStudio -> http://localhost:8000/v1
#
# NOTE: this is the SERVER-WIDE default. A model attached via PUT /api/llm
# overrides it (backend-only — there is no model form in the UI).

# --- Visual embedder: model + service ----------------------------------------
# Default CLIP is the larger, more accurate model (dim 768). clip-ViT-B-32 is
# lighter/faster (dim 512) — give it its own QDRANT_COLLECTION.
CLIP_MODEL=clip-ViT-L-14
CLIP_BATCH=128

# "Embedding is a URL." Set it and api/worker send batches to the warm
# clip_service.py container, whose weights load ONCE at boot instead of costing
# every Prefect subprocess a ~15-30s torch load. docker-compose sets it for you
# (http://clip:8001). On Fly leave it blank: the clip machine's internal address
# is derived from FLY_APP_NAME at runtime, so renaming the app needs no edit
# here. Blank and not on Fly = embed in-process (simple mode). Ignored for
# hosted providers — an API has no weights to keep warm.
EMBED_SERVICE_URL=
# Shared secret for that service. Leave BLANK for docker-compose or Fly's
# private *.internal networking (nothing external can reach it). SET IT — same
# value on the app AND the clip service — when clip runs on a public network,
# e.g. a GPU host elsewhere. Then /embed requires `Authorization: Bearer <token>`.
# Pair it with HTTPS: the token authenticates, it does not encrypt.
# EMBED_SERVICE_TOKEN=
# EMBED_VERSION=         # stamped on every vector; bump to force a re-index

# --- Per-branch overrides (optional — the provider preset fills them) --------
# IMAGE_EMBED_MODEL=         # blank -> the provider's default
# IMAGE_EMBED_DIM=           # blank -> from the registry; REQUIRED for a hosted
#                            # model the registry doesn't list
# IMAGE_EMBED_API_KEY=       # blank -> the provider's own key var above
# IMAGE_EMBED_BASE_URL=      # override the endpoint (proxy / self-hosted)
# IMAGE_EMBED_BATCH=         # images per request (default 128 local, 32 API)
# IMAGE_EMBED_CONCURRENCY=8  # in-flight requests for 1-image-per-call APIs
#
# Same six with a TEXT_EMBED_ prefix. TEXT_EMBED_BASE_URL is how you point the
# openai text embedder at your own vLLM / TEI server.
# TEXT_EMBED_MODEL=          # e.g. text-embedding-3-large (3072), or
#                            # BAAI/bge-small-en-v1.5 (384) for fastembed
# TEXT_EMBED_DIM=
# TEXT_EMBED_API_KEY=        # blank -> falls back to LLM_API_KEY
# TEXT_EMBED_BASE_URL=
# TEXT_EMBED_BATCH=64
#
# Hosted visual embedder sizes, for reference:
#   jina    jina-clip-v2           1024  (or 512 / 256 — Matryoshka, cheaper)
#   cohere  embed-v4.0             1536  (256 / 512 / 1024 / 1536)
#   voyage  voyage-multimodal-3.5  1024
#   gemini  gemini-embedding-2     1536  (768 / 1536 / 3072) — embeds ONE image
#           per request, ~9s each, and appears to serialize per key. A 400-frame
#           video is slow. Prefer clip/jina/cohere/voyage for bulk frames.

# --- Speech-to-text for uploads ----------------------------------------------
# Default whisper-1 reuses your OpenAI key (ASR_API_KEY -> OPENAI_API_KEY ->
# LLM_API_KEY), needs no GPU or download, and auto-splits audio over the API's
# 25MB/request limit. Uploads then get "said" moments like YouTube does.
# ASR_MODEL=whisper-1        # or gpt-4o-transcribe for higher accuracy
# ASR_API_KEY=               # blank = reuse the OpenAI key
# ASR_BASE_URL=              # an OpenAI-compatible ASR server
# ASR_LANGUAGE=              # blank = autodetect; e.g. en to pin it

# --- Reranker ----------------------------------------------------------------
# TEXT moments only — frame-only moments keep their RRF standing.
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # cohere: rerank-english-v3.0
# RERANK_TOP_K=30            # top text candidates re-judged per query
# RERANK_WEIGHT=0.7          # blend: 0 = RRF only, 1 = reranker only
# RERANK_API_KEY=            # cohere: reuses COHERE_API_KEY if blank
# RERANK_BASE_URL=

# =============================================================================
#  6 · Ingest tuning — frames, dedup, transcripts, speakers
# =============================================================================
FRAME_INTERVAL_SEC=2     # with FRAME_STRATEGY=interval
SCENE_THRESHOLD=0.4      # with FRAME_STRATEGY=scene; 0-1, lower = more frames
MAX_FRAMES=400           # hard cap per video, bounds cost and time
THUMB_WIDTH=480          # frames are downscaled in the same ffmpeg pass
# THUMB_QUALITY=3        # ffmpeg -q:v (2 best .. 31 worst)
DEDUP_MAX_DISTANCE=4     # Hamming distance on a 64-bit dHash

# TRANSCRIPT_CHUNK_SECONDS=20
# TRANSCRIPT_LANGS=en,en-US,en-GB    # caption languages to try, in order

# Speaker recognition. Gemini WATCHES the video (YouTube by URL; an upload goes
# through the Gemini Files API) and returns a speaker-change index that gets
# aligned onto the verbatim transcript. Video understanding is Gemini-ONLY, so
# this always uses GEMINI_API_KEY regardless of LLM_PROVIDER; without the key
# the API rejects a diarized upload up front. Needs google-genai (shipped).
# DIARIZE_MODEL=gemini-2.5-flash     # a video-capable Gemini model
# DIARIZE_WINDOW_S=600               # video seconds per Gemini call
# DIARIZE_MAX_WORKERS=6              # windows diarized in parallel

# =============================================================================
#  7 · Retrieval tuning — how many moments, and when to abstain
# =============================================================================
TOP_K=6      # fused moments fed to the LLM
KNN_K=24     # candidates fetched before trimming

# The gate: abstain WITHOUT calling the LLM when BOTH branches' best RAW score
# is below their threshold. Raw, not fused — RRF scores are far too small to
# threshold on. CLIP text->image cosines run low (~0.2-0.35); bge text-text runs
# higher (~0.5-0.7).
#
# LEAVE THESE COMMENTED to inherit the default calibrated for whichever provider
# you picked (0 = gate off for ones we haven't measured — the safe direction, it
# can never wrongly abstain). Setting them pins the value regardless of provider,
# and a threshold tuned for CLIP will silently over-abstain on another embedder.
# CONFIDENCE_THRESHOLD=0.2         # visual branch
# TEXT_CONFIDENCE_THRESHOLD=0.35   # transcript branch

# Fusion: both branches are ranked separately and merged by RANK, never by raw
# score (the two scales aren't comparable). Hits within FUSION_WINDOW_S seconds
# of each other in the same video become ONE moment, and a moment with BOTH a
# frame and a transcript hit is multiplied by CROSS_MODAL_BOOST.
# RRF_K=60
# FUSION_WINDOW_S=15
# CROSS_MODAL_BOOST=1.5
# BRANCH_TOP_K=20      # candidates fetched per branch before fusion

# =============================================================================
#  8 · YouTube downloads
#  yt-dlp 2025+ needs a JavaScript runtime + its EJS challenge-solver to extract
#  YouTube formats AT ALL — without them every video fails "This video is not
#  available". The Docker image installs Node and the worker fetches the solver
#  automatically. For BARE-PROCESS dev, install node or deno yourself.
#
#  COOKIES then get past sign-in / bot-checks and work EVERYWHERE (home AND
#  datacenter). Export once from a logged-in browser (a "Get cookies.txt"
#  extension, Netscape format), then supply them one of two ways:
#    LOCAL     save to ./data/cookies.txt (compose mounts ./data) and set
#              YT_COOKIES_FILE=/app/data/cookies.txt
#    DEPLOYED  fly secrets set YT_COOKIES_B64="$(base64 -w0 data/cookies.txt)"
#              — the worker writes it to a temp file at runtime, no mount needed
#
#  Cookies expire in a few weeks; re-export when YouTube starts failing again.
#  Uploads are unaffected by all of this.
# =============================================================================
YT_COOKIES_FILE=
YT_COOKIES_B64=
YT_PROXY_URL=            # alternative to cookies: http://user:pass@host:port
# Advanced — sensible defaults, rarely need changing:
# YT_JS_RUNTIMES=node                 # node ships in the image; or deno
# YT_REMOTE_COMPONENTS=ejs:github     # challenge-solver source
# YT_PLAYER_CLIENTS=                  # empty = yt-dlp's default (best)
# YT_FALLBACK_CLIENTS=tv,android,ios  # tried only if the default attempt fails

# =============================================================================
#  9 · "Import from Google Drive" button (optional)
#  OFF unless BOTH values are set — until then the workspace button is still
#  there, but says what's missing instead of opening a picker that can't work.
#  Nothing here is a server credential: the user picks a file in Google's own
#  popup and the BROWSER uploads it through the normal presigned path. No
#  refresh token is stored, no Google token reaches the API, and the scope is
#  drive.file (only the files the user picks — the scope that needs no Google
#  app verification). Both ids are sent to the page by design.
#
#  Google Cloud console -> your project:
#    1. APIs & Services -> Library -> enable "Google Picker API"
#    2. Credentials -> Create credentials -> OAuth client ID -> Web application
#       Authorized JavaScript origins: your app origin(s), e.g.
#         http://localhost:8000  and/or  https://your-app.fly.dev
#       (origins only — this flow uses no redirect URI)
#    3. Credentials -> Create credentials -> API key (restrict it to the Picker
#       API and those same origins)
#  The consent screen can stay in "Testing" for personal use; add yourself as a
#  test user.
# =============================================================================
GDRIVE_CLIENT_ID=
GDRIVE_API_KEY=

# =============================================================================
#  10 · Single-user identity
#  !! THIS DEPLOYMENT HAS NO AUTHENTICATION. Every request acts as one account;
#  !! opening the app IS being logged in as it. X-User-Id and Authorization
#  !! headers are IGNORED, not honoured. Bind this to localhost or put an
#  !! authenticating proxy in front of it.
#
#  ADMIN_TOKEN is NOT enforced — require_auth() in src/api/videos.py is a
#  deliberate no-op, kept as the single place to restore a check. It stays here
#  only for operator scripts.
#
#  Every bucket key, Postgres row and Qdrant point is still user_id-tagged, so
#  restoring real auth means resolving a per-request user id again, not
#  reshaping data.
# =============================================================================
# ADMIN_TOKEN=
# SINGLE_USER_ID=default    # changing this orphans the pre-indexed samples
# SINGLE_USER_NAME=admin    # a UI label; nothing keys off it
