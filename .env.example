# ============================================================
# MomentSearch — configuration
# Copy to .env and fill in. Only ONE storage provider block is
# active at a time — set STORAGE_PROVIDER and that provider's credentials.
# For queue + manifest you need Prefect Cloud + Neon (both free tiers).
# ============================================================

# --- Database (Neon Postgres) — the videos manifest ---------
# Neon console -> your project -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- API auth ------------------------------------------------
# Required on every mutating endpoint (presign, register, delete, retry) as
# `Authorization: Bearer <token>`. Empty = auth disabled (dev only!).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me
# Tenant id used when no X-User-Id header is sent. Every bucket key, Postgres
# row and Qdrant point is user_id-tagged — swap in real auth later freely.
# DEFAULT_USER_ID=default

# --- Demo sign-in (email -> workspace) -----------------------
# POST /api/auth/demo trades an email for a workspace id (u_<uuid>) and an
# HMAC-signed session token; the API then derives the tenant from the
# signature, so X-User-Id can't be spoofed. AUTH_SECRET signs those tokens.
# Unset = a random per-process key: sign-ins won't survive a restart and won't
# validate across replicas. SET THIS in any real deploy.
# Generate one:  openssl rand -hex 32
# AUTH_SECRET=
# How long a session token stays valid.
# SESSION_TTL_DAYS=30
#
# NOTE: demo sign-in has no password and no verification — anyone who types an
# address gets that workspace. It exists to give a demo real, separate,
# persistent workspaces. Put a real IdP (Clerk/JWT/OAuth) in front of
# /api/auth/* before real users depend on it; the tenant model doesn't change.

# ============================================================
# Object storage — raw videos + frame thumbnails
# All providers speak the S3 API (GCS via its S3-interoperability mode,
# Fly via Tigris) — one client, switched by env — except gcp_native,
# which uses Google's own SDK with a service-account JSON.
# STORAGE_PROVIDER: local | aws | gcp | gcp_native | flyio
#
# Credentials use provider-neutral STORAGE_* names (AWS_* names are also
# accepted as fallbacks — that's what boto3 reads natively and what Fly's
# `fly storage create` injects automatically).
#
# IMPORTANT (browser uploads): the bucket needs a CORS rule allowing PUT
# from your site's origin, or presigned uploads will fail in the browser:
#   AWS:    aws s3api put-bucket-cors --bucket X --cors-configuration '{"CORSRules":[{"AllowedMethods":["PUT","GET"],"AllowedOrigins":["https://your.app"],"AllowedHeaders":["*"]}]}'
#   GCS:    gcloud storage buckets update gs://X --cors-file=cors.json
#   Tigris: fly storage dashboard -> your bucket -> Settings -> CORS
# Keep the bucket PRIVATE — only presigned URLs get in or out.
# ============================================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
AWS_ENDPOINT_URL_S3=

# Presigned-upload guardrails.
MAX_UPLOAD_MB=2048
PRESIGN_EXPIRY_S=900
PRESIGN_GET_EXPIRY_S=3600

# ------------------------------------------------------------
# 1) LOCAL (dev default — no credentials, no bucket, no presigning:
#    the API accepts/serves bytes itself; files land under ./data/)
# ------------------------------------------------------------
# STORAGE_PROVIDER=local

# ------------------------------------------------------------
# 2) AWS S3
#    - Create a bucket:  aws s3 mb s3://momentsearch
#    - IAM user with s3:PutObject/GetObject/HeadObject/DeleteObject/ListBucket
#      on the bucket, then create an access key (IAM -> Security credentials).
#    - STORAGE_REGION must be the bucket's real region (e.g. us-east-1).
# ------------------------------------------------------------
# STORAGE_PROVIDER=aws
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=AKIA................
# STORAGE_SECRET_ACCESS_KEY=....................
# STORAGE_REGION=us-east-1

# ------------------------------------------------------------
# 3) GCP (Google Cloud Storage via its S3-interoperability API)
#    - Create a bucket; service account with "Storage Object Admin" on it.
#    - Cloud Console -> Cloud Storage -> Settings -> Interoperability ->
#      create an HMAC key for that service account; the Access key / Secret
#      pair goes in the STORAGE_* vars.
# ------------------------------------------------------------
# STORAGE_PROVIDER=gcp
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=GOOG1E..............
# STORAGE_SECRET_ACCESS_KEY=....................
# STORAGE_REGION=auto

# ------------------------------------------------------------
# 3b) GCP NATIVE (Google's SDK + service-account JSON — no HMAC keys)
#     Requires: pip install google-cloud-storage
# ------------------------------------------------------------
# STORAGE_PROVIDER=gcp_native
# STORAGE_BUCKET=momentsearch-media
# GOOGLE_CLOUD_PROJECT_ID=your-project
# GOOGLE_CLOUD_PRIVATE_KEY_ID=....................
# GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CLOUD_CLIENT_EMAIL=sa-name@your-project.iam.gserviceaccount.com
# GOOGLE_CLOUD_CLIENT_ID=....................
# GOOGLE_CLOUD_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/sa-name%40your-project.iam.gserviceaccount.com

# ------------------------------------------------------------
# 4) FLY.IO (Tigris — Fly's native S3-compatible object storage)
#    - From the app directory:  fly storage create
#      (injects the AWS_*-named secrets + BUCKET_NAME on the deployed app,
#       so on Fly you only set STORAGE_PROVIDER=flyio.)
#    - To use the same bucket locally, copy the keys from the Tigris dashboard.
# ------------------------------------------------------------
# STORAGE_PROVIDER=flyio
# STORAGE_BUCKET=momentsearch-media
# STORAGE_ACCESS_KEY_ID=tid_................
# STORAGE_SECRET_ACCESS_KEY=tsec_................

# ============================================================
# YouTube downloads. Modern yt-dlp (2025+) needs a JavaScript runtime + its
# EJS challenge-solver to extract YouTube formats AT ALL — without them every
# video fails "This video is not available". The Docker image installs Node
# and the worker fetches the solver automatically (YT_JS_RUNTIMES /
# YT_REMOTE_COMPONENTS below). For BARE-PROCESS dev, install node or deno.
#
# COOKIES then get you past sign-in/bot-checks and work EVERYWHERE (home AND
# datacenter). Export once from a logged-in browser (a "Get cookies.txt"
# extension → Netscape format), then supply them one of two ways:
#
#   LOCAL — mount the file:
#     1. save it to ./data/cookies.txt   (compose already mounts ./data)
#     2. YT_COOKIES_FILE=/app/data/cookies.txt
#
#   DEPLOYED (Fly/cloud) — as a secret (no file mount needed):
#     base64 the file and set it as YT_COOKIES_B64; the worker writes it to a
#     temp file at runtime. Example:
#       fly secrets set YT_COOKIES_B64="$(base64 -w0 data/cookies.txt)"
#
# Cookies expire in a few weeks — re-export when YouTube starts failing again.
# Alternative to cookies: a residential proxy — YT_PROXY_URL=http://user:pass@host:port
# (Uploads are unaffected by any of this — it only touches the YouTube path.)
# ============================================================
YT_COOKIES_FILE=
YT_COOKIES_B64=
YT_PROXY_URL=
# Advanced — sensible defaults, rarely need changing:
# YT_JS_RUNTIMES=node               # JS runtime yt-dlp uses (node ships in the image; or deno)
# YT_REMOTE_COMPONENTS=ejs:github   # challenge-solver source
# YT_PLAYER_CLIENTS=                # empty = yt-dlp default (best); only override to force
# YT_FALLBACK_CLIENTS=tv,android,ios  # tried only if the default attempt fails

# ============================================================
# Work orchestration (Prefect Cloud) — the queue between the upload
# API and the ingest workers. The API only schedules runs; workers
# (python worker.py) poll Prefect Cloud over outbound HTTPS and execute
# them. Queue/run view: https://app.prefect.cloud (free tier, no card).
# Setup: sign up -> avatar menu -> API Keys -> Create. PREFECT_API_URL is
#   https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
# ============================================================
PREFECT_API_URL=
PREFECT_API_KEY=
# Concurrent flow runs per worker process (each is an isolated subprocess,
# ffmpeg + CLIP ≈ 1-1.5GB peak — size the machine accordingly).
WORKER_CONCURRENCY=2

# Fair scheduling (WFQ). true = videos wait in a fair queue and a dispatcher
# admits them round-robin across users, so one bulk uploader can't starve
# others. false = plain FIFO (immediate enqueue). DISPATCH_MAX_INFLIGHT should
# equal total capacity = (worker machines) x WORKER_CONCURRENCY.
ENABLE_FAIR_DISPATCH=true
DISPATCH_MAX_INFLIGHT=2
# DISPATCH_INTERVAL_S=3

# ============================================================
# Qdrant (vector index) — one shared multi-tenant collection.
# Empty QDRANT_URL -> embedded local instance under ./data/qdrant
# (single-process dev ONLY — API and worker can't share it; docker-compose
# runs a real local Qdrant instead). Qdrant Cloud: cluster URL + API key
# from cloud.qdrant.io -> your cluster -> "API Keys".
# ============================================================
QDRANT_URL=
QDRANT_API_KEY=
# Frame (visual) collection. Default matches the clip-ViT-L-14 model below;
# the model and collection must be kept in sync (a different CLIP model = a new
# collection, since the vector dim changes).
QDRANT_COLLECTION=moments_l14
# Low-RAM profile (default ON — frame vectors balloon fast): originals on
# disk, int8 copies pinned in RAM (~4x smaller), HNSW graph on disk, queries
# rescore from the originals. On a big-RAM node flip these off for speed.
QDRANT_QUANTIZATION=true
QDRANT_ON_DISK=true
QDRANT_HNSW_ON_DISK=true

# ============================================================
# Frame sampling — the biggest scaling lever (stops thousands of videos
# becoming billions of near-identical vectors).
# FRAME_STRATEGY: interval (every FRAME_INTERVAL_SEC) | scene (per cut)
# ============================================================
FRAME_STRATEGY=interval
FRAME_INTERVAL_SEC=2
# Scene-cut sensitivity (0-1) when FRAME_STRATEGY=scene; lower = more frames.
SCENE_THRESHOLD=0.4
# Cap frames per video to bound cost/time.
MAX_FRAMES=400
# Thumbnails are downscaled in the same ffmpeg pass (browser + LLM never
# need full-res); perceptual-hash dedup drops near-identical neighbours
# BEFORE they cost CLIP compute and storage.
THUMB_WIDTH=480
# THUMB_QUALITY=3        # ffmpeg -q:v for thumbnails (2 best .. 31 worst)
DEDUP_ENABLED=true
DEDUP_MAX_DISTANCE=4

# ============================================================
# VISUAL EMBEDDINGS — the frame branch. One model embeds frames AND text
# queries into a SHARED space, which is what lets a question match what is
# *seen* on screen. The default (local CLIP) needs no API key at all.
#
# IMAGE_EMBED_PROVIDER — pick one; the provider name alone sets the endpoint,
# the default model and the vector dim:
#   clip   (default) local sentence-transformers CLIP. Free, offline, CPU-fine.
#   jina             jina-clip-v2 API. Multilingual, Matryoshka dims. JINA_API_KEY
#   cohere           embed-v4.0 API. Best on text-heavy frames.  COHERE_API_KEY
#   voyage           voyage-multimodal-3.5 API.                   VOYAGE_API_KEY
#   gemini           gemini-embedding-2: one unified space for text+images.
#                                                                 GEMINI_API_KEY
# Providers that AREN'T here (OpenAI) have no image-embedding model — the visual
# branch needs a joint text+image space, not any embedder.
#
# !! Switching provider or model CHANGES THE VECTOR DIM. The old index becomes
# !! unusable and MomentSearch will refuse to mix them: re-ingest, or point
# !! QDRANT_COLLECTION at a fresh collection name. `python -m src.providers`
# !! shows exactly what your .env resolves to.
#
# EMBED_SERVICE_URL — "embedding is a URL". Set it and api/worker send batches
# to the warm clip_service.py container (weights load ONCE at its boot — no
# ~15-30s reload per video). docker-compose sets it for you (http://clip:8001);
# on Fly it's in fly.toml. Point it at a GPU machine later — nothing else
# changes. Unset = embed in-process (simple mode). Ignored for hosted providers:
# an API has no weights to keep warm. CLIP_SERVICE_URL still works as an alias.
# ============================================================
# IMAGE_EMBED_PROVIDER=clip
# Default is the larger, more accurate CLIP (dim 768). For a lighter/faster
# option set clip-ViT-B-32 (dim 512) — and give it its own QDRANT_COLLECTION.
CLIP_MODEL=clip-ViT-L-14
CLIP_BATCH=128
EMBED_SERVICE_URL=
# EMBED_VERSION=                  # stamped on every vector; bump to force re-index
#
# Full set of per-branch overrides (all optional — the provider preset fills them):
# IMAGE_EMBED_MODEL=              # blank -> the provider's default model
# IMAGE_EMBED_DIM=                # blank -> from the registry table; REQUIRED for
#                                 # a hosted model the table doesn't list
# IMAGE_EMBED_API_KEY=            # blank -> the provider's own key env var below
# IMAGE_EMBED_BASE_URL=           # override the endpoint (proxy / self-hosted)
# IMAGE_EMBED_BATCH=              # images per request (default 128 local, 32 API)
# IMAGE_EMBED_CONCURRENCY=8       # in-flight requests for 1-image-per-call APIs
#
# --- hosted visual embedders: uncomment ONE block ---
# IMAGE_EMBED_PROVIDER=jina
# JINA_API_KEY=
# IMAGE_EMBED_MODEL=jina-clip-v2
# IMAGE_EMBED_DIM=1024            # or 512 / 256 — Matryoshka, smaller = cheaper
#
# IMAGE_EMBED_PROVIDER=cohere
# COHERE_API_KEY=
# IMAGE_EMBED_MODEL=embed-v4.0
# IMAGE_EMBED_DIM=1536            # 256 / 512 / 1024 / 1536
#
# IMAGE_EMBED_PROVIDER=voyage
# VOYAGE_API_KEY=
# IMAGE_EMBED_MODEL=voyage-multimodal-3.5
# IMAGE_EMBED_DIM=1024
#
# IMAGE_EMBED_PROVIDER=gemini     # needs: pip install google-genai
# GEMINI_API_KEY=
# IMAGE_EMBED_MODEL=gemini-embedding-2
# IMAGE_EMBED_DIM=1536            # 768 / 1536 / 3072
# IMAGE_EMBED_CONCURRENCY=8       # Gemini embeds ONE image per request, ~9s each
#                                 # (measured) and appears to serialize per key —
#                                 # a 400-frame video is slow. Prefer clip/jina/
#                                 # cohere/voyage for bulk frames, or raise
#                                 # FRAME_INTERVAL_SEC / lower MAX_FRAMES.
#
# Any hosted block also wants its own collection so old vectors can't collide:
# QDRANT_COLLECTION=moments_v2
# And CONFIDENCE_THRESHOLD below defaults to 0 (gate off) for these, because
# their cosine scale isn't the same as CLIP's — measure yours before setting it.

# ============================================================
# Sample corpus — a one-shot 'seed' startup gate indexes the four
# "Deep Dive into LLMs" talks (src/samples.py) so the / page answers
# questions immediately after `docker compose up`. Set false to skip.
# ============================================================
SEED_SAMPLE_VIDEOS=true

# ============================================================
# Retrieval / faithfulness
# Gate 1: the API abstains ("couldn't find that") WITHOUT calling the LLM if
# BOTH branches' best raw score is below their threshold. CLIP text->image
# cosines run low (~0.2-0.35); bge text-text cosines run higher (~0.5-0.7).
#
# Leave these COMMENTED to inherit the default calibrated for whichever
# embedding provider you chose (0 = gate off for providers we haven't measured,
# which is the safe direction — it can never abstain on a good match). Setting
# them explicitly pins the value regardless of provider: a threshold tuned for
# CLIP will silently over-abstain on a different embedder.
# ============================================================
TOP_K=6
KNN_K=24
# CONFIDENCE_THRESHOLD=0.2            # visual branch (0.2 = CLIP default)
# TEXT_CONFIDENCE_THRESHOLD=0.35     # transcript branch (0.35 = bge default)

# ============================================================
# Multimodal — the transcript (text) branch + fusion (Path 1)
# The visual branch is CLIP frames. This adds a SECOND branch: the transcript —
# YouTube captions, and for UPLOADS the audio transcribed by Whisper ASR (see
# the ASR section below). Chunked by time and embedded with a semantic text
# model. At query time both branches run and fuse by RANK (RRF); hits within
# FUSION_WINDOW_S seconds merge into one "moment", and a window with BOTH a frame
# and a transcript hit gets CROSS_MODAL_BOOST. A caption-less YouTube video with
# no audio just indexes visually. Set ENABLE_TRANSCRIPT=false for pure visual.
# ============================================================
ENABLE_TRANSCRIPT=true
# Transcript (text) collection. Default matches the openai text model below;
# keep it in sync with the provider (different provider = different dim = its own
# collection).
TEXT_COLLECTION=moments_text_openai
#
# Transcript-branch embedding provider — the name alone sets model + dim:
#   openai (default)    = OpenAI text-embedding-3-small (dim 1536). Reuses your
#                         OpenAI key (falls back to LLM_API_KEY), so ONE key powers
#                         the answer AND the transcript embeddings. Also any
#                         OpenAI-compatible server (vLLM/TEI/Together via
#                         TEXT_EMBED_BASE_URL). >>> needs OPENAI_API_KEY <<<
#   fastembed           = bge via fastembed: CPU, free, NO API key. Dim 384. Set
#                         this to run the transcript branch keyless.
#   gemini              = gemini-embedding-2 (pip install google-genai)     1536
#   cohere              = embed-v4.0                                        1536
#   voyage              = voyage-3.5                                        1024
#   jina                = jina-embeddings-v3                                1024
# This branch is INDEPENDENT of the visual one — they fuse by rank, so local CLIP
# frames + hosted OpenAI/Gemini transcripts is a perfectly good combination.
# NOTE: switching provider changes the vector dim, so you must RE-INDEX the
# transcript collection (python -m src.seed) — the old vectors are incompatible.
# TEXT_EMBED_PROVIDER=openai
# TEXT_EMBED_MODEL=text-embedding-3-small      # or text-embedding-3-large (3072)
# TEXT_EMBED_DIM=1536
# TEXT_EMBED_API_KEY=                          # blank -> falls back to LLM_API_KEY
# TEXT_EMBED_BASE_URL=                         # blank -> OpenAI; set for a compatible server
#
# --- keyless alternative: bge via fastembed (TEXT_EMBED_PROVIDER=fastembed) ---
# TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5      # or bge-base (768) / bge-large (1024)
# TEXT_EMBED_DIM=384
#
# --- other hosted providers: the key env var is enough ---
# TEXT_EMBED_PROVIDER=gemini
# GEMINI_API_KEY=
# TEXT_EMBED_PROVIDER=cohere
# COHERE_API_KEY=
# TEXT_EMBED_PROVIDER=voyage
# VOYAGE_API_KEY=
# TEXT_EMBED_PROVIDER=jina
# JINA_API_KEY=
#
# TEXT_EMBED_BATCH=64                          # inputs per request (hosted APIs)
# On a FRESH deploy this just works. Switching an EXISTING deploy: also give it a
# new collection so old 384-dim bge vectors don't collide, then re-seed:
# TEXT_COLLECTION=moments_text_openai
#
# TRANSCRIPT_CHUNK_SECONDS=20
# TRANSCRIPT_LANGS=en,en-US,en-GB   # caption languages to try, in order
#
# --- Speech-to-text (ASR) for UPLOADS -----------------------------------------
# YouTube gives us captions; uploaded files don't, so their transcript branch is
# produced by ASR from the file's own audio. Default: OpenAI whisper-1, which
# reuses your OpenAI key (ASR_API_KEY -> OPENAI_API_KEY -> LLM_API_KEY), needs no
# GPU or model download, and auto-splits audio over the API's 25MB/request limit.
# Uploads then get "said" moments and the synced transcript panel, just like
# YouTube. Set ENABLE_ASR=false to leave uploads visual-only.
# ENABLE_ASR=true
# ASR_PROVIDER=openai
# ASR_MODEL=whisper-1          # or gpt-4o-transcribe for higher accuracy
# ASR_API_KEY=                 # blank = reuse OPENAI_API_KEY / LLM_API_KEY
# ASR_BASE_URL=                # optional: an OpenAI-compatible ASR server
# ASR_LANGUAGE=                # blank = autodetect; e.g. en to pin it
# RRF_K=60
# FUSION_WINDOW_S=15
# CROSS_MODAL_BOOST=1.5
# BRANCH_TOP_K=20          # candidates fetched per branch before fusion
#
# --- Reranker (cross-encoder) — fixes RRF's rank-blindness ---------------------
# RRF orders by branch RANK and ignores how relevant a hit really is, so a
# spurious top-1 can outrank the real answer one rank lower. A cross-encoder
# re-reads each (question, transcript) pair and grades true relevance, blended
# with the RRF standing. TEXT moments only (frame-only moments keep their RRF
# standing). Default fastembed = local ONNX, NO API key, CPU (downloads a ~90MB
# model on first query). Set ENABLE_RERANK=true to switch it on.
# ENABLE_RERANK=false
# RERANK_PROVIDER=fastembed          # or cohere
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # cohere: rerank-english-v3.0
# RERANK_TOP_K=30                    # top text candidates re-judged per query
# RERANK_WEIGHT=0.7                  # blend: 0=RRF only, 1=reranker only
# RERANK_API_KEY=                    # cohere: reuses COHERE_API_KEY if blank
# RERANK_BASE_URL=                   # optional OpenAI/Cohere-compatible endpoint

# ============================================================
# MULTIMODAL LLM — only synthesizes the final cited answer from frames already
# retrieved. Retrieval itself is local and needs no key, so this is OPTIONAL:
# with no model configured MomentSearch returns ranked cited moments instead of
# a written answer.
#
# Pick a provider by NAME and it fills in the endpoint + a default model. The key
# is read from that provider's usual env var, so this is a complete config:
#     LLM_PROVIDER=gemini
#     GEMINI_API_KEY=...
#
#   provider        key env var           default model
#   openai          OPENAI_API_KEY        gpt-4o
#   gemini          GEMINI_API_KEY        gemini-3.6-flash   (pip install google-genai)
#   gemini_openai   GEMINI_API_KEY        gemini-3.6-flash   (no extra install)
#   anthropic       ANTHROPIC_API_KEY     claude-sonnet-5    (pip install anthropic)
#   openrouter      OPENROUTER_API_KEY    openai/gpt-4o-mini
#   xai (grok)      XAI_API_KEY           grok-4.5
#   groq            GROQ_API_KEY          — set LLM_MODEL
#   together        TOGETHER_API_KEY      Qwen/Qwen2.5-VL-72B-Instruct
#   fireworks       FIREWORKS_API_KEY     — set LLM_MODEL
#   mistral         MISTRAL_API_KEY       pixtral-12b-2409
#   nvidia          NVIDIA_API_KEY        meta/llama-3.2-11b-vision-instruct
#   azure_openai    AZURE_OPENAI_API_KEY  — LLM_MODEL is your DEPLOYMENT name,
#                                           endpoint from AZURE_OPENAI_ENDPOINT
#   ollama          (none)                qwen2.5vl        localhost:11434
#   lmstudio        (none)                — set LLM_MODEL  localhost:1234
#   vllm            (none)                — set LLM_MODEL  localhost:8000
#   custom          (optional)            — set LLM_BASE_URL to any
#                                           OpenAI-compatible server
# Aliases work too: grok, claude, google, azure, lm-studio, open-router.
# `python -m src.providers` prints this table plus what YOUR .env resolves to.
#
# NOTE: this is the SERVER-WIDE FALLBACK. Each user can attach their own model
# via PUT /api/llm or the "Use your own model" card in the UI — that overrides
# these for them. GET /api/providers lists what they can choose.
# ============================================================
LLM_PROVIDER=openai
LLM_API_KEY=
# Careful: LLM_API_KEY takes precedence over the provider-specific var above. If
# you switch LLM_PROVIDER, either update this or clear it — a leftover key from
# another provider is the #1 cause of "API key not valid".
#
# Optional. Blank = the provider's own endpoint (pre-filled from the table).
# Set it to reach YOUR server with any OpenAI-shaped provider:
#   Ollama        -> http://localhost:11434/v1
#   vLLM/LMStudio -> http://localhost:8000/v1
LLM_BASE_URL=
# Must be a VISION-capable model (it is shown the actual video frames).
# Blank = the provider's default (gpt-4o for openai). gpt-4o-mini is cheaper but
# hallucinates more on grounded answers; gpt-4o is the default here.
LLM_MODEL=gpt-4o
# Frames are downscaled to this before the LLM — images are token-expensive
# and the multimodal call is where cost/latency actually live.
LLM_IMAGE_MAX_PX=512
# LLM_MAX_TOKENS=1024      # max length of the synthesized answer
