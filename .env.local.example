# ============================================================
#  LOCAL  —  run MomentSearch on your OWN machine.
#
#  This is the LOCAL settings file. Copy it to .env and start the stack:
#      cp env.local.example .env && docker compose up
#
#  It keeps storage, the vector store, and the models ON YOUR MACHINE (no cloud
#  bucket, no Qdrant Cloud, no API keys for embeddings/rerank). You still supply
#  a Postgres URL and a Prefect queue (free cloud tiers, or self-hosted) — those
#  aren't bundled locally yet. For the full reference with every provider,
#  cloud/deploy option and knob, see .env.example instead.
# ============================================================

# ---- Local storage: files under ./data, no bucket, no keys ------------------
STORAGE_PROVIDER=local

# ---- Local Qdrant: compose starts it automatically (nothing to uncomment) ---
# COMPOSE_PROFILES tells docker compose to bring up the bundled `qdrant` service;
# QDRANT_URL points the app at it. That's the whole local-Qdrant setup.
COMPOSE_PROFILES=local-qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- Local, keyless models --------------------------------------------------
# Visual frames — local CLIP (default, no key, CPU-fine).
IMAGE_EMBED_PROVIDER=clip

# Transcript embeddings — local bge via fastembed (no key). Needs its OWN
# collection (its vectors are a different size from the OpenAI default).
TEXT_EMBED_PROVIDER=fastembed
TEXT_COLLECTION=moments_text_bge

# Reranker — local ONNX cross-encoder (no key), on by default.
ENABLE_RERANK=true

# Upload speech-to-text defaults to OpenAI Whisper (needs a key). Keep it OFF for
# a fully-keyless local run — uploaded videos then index visually only.
ENABLE_ASR=false

# Answer LLM — leave UNSET for retrieval-only (ranked, clickable moments, no
# written answer). For a written answer pick ONE:
#   local, no key — install Ollama, pull a vision model, then:
#     LLM_PROVIDER=ollama
#     LLM_MODEL=qwen2.5vl
#     LLM_BASE_URL=http://host.docker.internal:11434/v1   # reach host Ollama from Docker
#   hosted key:
#     LLM_PROVIDER=openai
#     LLM_API_KEY=sk-...

# ---- Still required (no bundled local option yet) ---------------------------
# Postgres — the video manifest. A local Postgres, or a free Neon URL.
DATABASE_URL=

# Prefect — the ingest queue. Prefect Cloud (free tier) or a self-hosted server.
PREFECT_API_URL=
PREFECT_API_KEY=
