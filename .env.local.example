# =============================================================================
#  MomentSearch — LOCAL preset.  Run it on your own machine.
#
#      cp .env.local.example .env && docker compose up
#
#  Storage, the vector store, the database, embeddings and reranking all stay ON
#  YOUR MACHINE — keyless. Two things go in PART 2: PREFECT (required, free) and
#  — to unlock written answers + upload transcription — your OpenAI key.
#
#  PART 1 · DECISIONS   already made for a keyless local stack. Change freely.
#  PART 2 · VALUES      where each of those decisions points.
#
#  Every provider, cloud option and knob lives in .env.example instead.
# =============================================================================


# #############################################################################
#  PART 1 · DECISIONS
# #############################################################################

# --- Where the data lives ----------------------------------------------------
# Your uploads: files under ./data — no bucket, no keys, no presigning.
# The ten sample videos are NOT here and are not your problem: they ship
# pre-indexed in demo_corpus/ and are read from there at runtime, so /demo
# answers the moment the stack is up, with nothing indexed and no key set.
STORAGE_PROVIDER=local

# Bundled containers `docker compose up` starts for you. Postgres is listed
# here; qdrant is not, because it always runs — it holds the shipped demo
# corpus. Drop local-postgres to use a hosted database instead.
COMPOSE_PROFILES=local-postgres

# --- Which models — all local, all keyless -----------------------------------
# Frames + the question, one shared space. CPU is fine.
# clip-ViT-L-14 (dim 768) is NOT a free choice here: the shipped corpus in
# demo_corpus/ was embedded with it, and a query embedded by a different model
# lands in a different space — the demo would return nothing. Change it only
# together with rebuilding the corpus (src/build_demo_corpus.py).
IMAGE_EMBED_PROVIDER=clip
CLIP_MODEL=clip-ViT-L-14

# Transcript chunks — OpenAI text-embedding-3-small, for the same reason as the
# frame model above: that is what the shipped corpus was built with, so it is
# what a question must be embedded with to match. This is the ONE place this
# preset is not keyless — paste the OpenAI key in PART 2 and the transcript half
# of search works. Without a key the demo still answers from what's ON SCREEN
# (the CLIP branch is local), it just loses the spoken-word half.
TEXT_EMBED_PROVIDER=openai

# Reranker — local ONNX cross-encoder. First query downloads a ~90MB model.
RERANK_PROVIDER=fastembed

# Answer LLM — OpenAI (gpt-4o). Paste OPENAI_API_KEY in PART 2 for written, cited
# answers. Leave the key blank and you still get retrieval-only: ranked, clickable
# moments with thumbnails and timestamps, just no prose. (Local model? See PART 2.)
LLM_PROVIDER=openai

# --- Features on / off -------------------------------------------------------
ENABLE_TRANSCRIPT=true
ENABLE_RERANK=true

# Upload speech-to-text via OpenAI Whisper — reuses the SAME OpenAI key. With the
# key set, uploads get a transcript branch too; with it blank they index visually
# only (no error). YouTube always uses its own captions.
ENABLE_ASR=true

# Nothing is indexed at startup: the samples are restored from demo_corpus/
# (src/demo_restore.py) in about a second. That is the default whenever the
# corpus folder is present — SEED_MODE=ingest re-indexes them live instead.
SEED_SAMPLE_VIDEOS=true


# #############################################################################
#  PART 2 · VALUES
# #############################################################################

# =============================================================================
#  Deploy marker (src/preflight.py). Marks the run as a deploy so the sanity
#  check runs. NOTE: this is a LOCAL preset, so with DEPLOY_ENV set the check
#  WILL print warnings on startup about the local settings below
#  (STORAGE_PROVIDER=local, the compose qdrant/postgres hosts) — that's expected
#  and harmless here; the app still starts (STRICT_DEPLOY_CHECK is not set).
#  Comment this out to silence those warnings for pure local dev.
# =============================================================================
DEPLOY_ENV=production

# =============================================================================
#  >>> FILL THIS IN — the only thing this preset can't run locally <<<
#  Prefect is the queue between the API and the ingest workers.
#  Free tier, no card: app.prefect.cloud -> avatar -> API Keys -> Create.
#  PREFECT_API_URL looks like
#    https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
#  (A self-hosted `prefect server` works too — same two variables.)
# =============================================================================
PREFECT_API_URL=
PREFECT_API_KEY=

# =============================================================================
#  Qdrant — the bundled service, always running, storage = ./demo_corpus/qdrant.
#  That folder IS the shipped demo corpus, which is why the demo needs no setup.
#  Pointing YOUR uploads at the same service (below) keeps this a one-container
#  stack; your vectors then sit in that folder too, which is harmless (it is
#  git-ignored) but is why a hosted URL is the tidier choice once you have real
#  data. Either way the samples answer from the shipped collections.
# =============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Collections. These are the names inside demo_corpus/qdrant. Renaming them
# moves YOUR videos to a new collection; the samples are read from the shipped
# names either way, so the demo survives it.
IMAGE_COLLECTION=moments_l14
TEXT_COLLECTION=moments_text_openai

# =============================================================================
#  Local Postgres — started by the local-postgres profile above.
#  Tables create themselves on first start (src/db.py init_schema), so there's
#  nothing to migrate or import. Compose waits for its healthcheck before
#  seed/api/worker connect, so a first `up` — which runs initdb — is still one
#  command. Data persists in the `pgdata` volume; reach it from the host with
#    psql postgresql://ms:ms@localhost:5433/ms
#
#  NOTE: a fresh empty database is fine — the ten sample rows are replayed from
#  demo_corpus/manifest.sql on every start, so nothing has to be re-indexed and
#  the first `up` is as fast as the tenth.
#
#  TO USE A HOSTED DATABASE (Neon etc.): paste its URL over the line below AND
#  drop local-postgres from COMPOSE_PROFILES in PART 1. The bundled service is
#  then never created.
# =============================================================================
DATABASE_URL=postgresql://ms:ms@postgres:5432/ms

# =============================================================================
#  >>> OpenAI key — PASTE IT to get the WHOLE app <<<
#  ONE key powers both the written, cited ANSWERS (LLM_PROVIDER=openai, gpt-4o)
#  and UPLOAD TRANSCRIPTION (Whisper, ENABLE_ASR=true) — both already set in
#  PART 1, so pasting this is all it takes. Leave it blank and the app still runs:
#  retrieval-only answers + visual-only uploads, nothing errors.
#  Get one: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY=

# Prefer a LOCAL answer model instead (no key)? Install Ollama, pull a vision
# model (`ollama pull qwen2.5vl:3b`), set LLM_PROVIDER=ollama in PART 1 and
# uncomment these:
# LLM_MODEL=qwen2.5vl:3b
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # reach host Ollama from Docker
#
# This works with no extra setup. A local model can only read so much at once, so
# MomentSearch automatically sends it 3 moments instead of 6, with smaller frames,
# and the answer says it did. Two things to expect, measured on a laptop with no
# GPU: about 5 and a half minutes per answer, and a 3B model that often writes no
# [1] [2] citations, so nothing in the answer is clickable. A GPU fixes the speed;
# a bigger model helps the citations. Full details in MODELS.md.

# =============================================================================
#  YouTube ingest (only if a YouTube link won't ingest)
#  YouTube bot-checks by IP, so fetching a video — especially its CAPTIONS — can
#  fail with "Sign in to confirm you're not a bot"; the video may still index
#  visually, but with no transcript. Your own IP can get blocked too. Two fixes:
#
#  EASIEST — SocialKit (a hosted API that returns BOTH the transcript and the
#  video from its own servers; no cookies, no IP fight). Free: 20 credits, then
#  paid. Paste the key and it's used automatically. Docs: docs.socialkit.dev
# SOCIALKIT_API_KEY=your_key_here
#
#  OR cookies — export cookies.txt from a logged-in browser (a "Get cookies.txt"
#  extension -> Netscape format), save to ./secrets/cookies.txt, and uncomment:
# YT_COOKIES_FILE=/app/secrets/cookies.txt
#  (Cookies expire in ~2-3 weeks. Uploads are unaffected — this is YouTube-only.)
# =============================================================================
